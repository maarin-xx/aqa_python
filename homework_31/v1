
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install dependencies') {
            steps {
                sh 'python3 -m venv .venv'
                sh '.venv/bin/pip install -r requirements.txt'
            }
        }

        stage('Run tests') {
            steps {
                sh '.venv/bin/pytest homework_24/test_cars.py --junitxml=results.xml'
            }
        }

        stage('Publish test results') {
            steps {
                junit 'results.xml'
            }
        }
    }
}
